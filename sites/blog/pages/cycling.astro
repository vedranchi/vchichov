---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WoodPanel from '../components/WoodPanel.astro';
import PixelButton from '../components/PixelButton.astro';
import data from '@shared/data/cycling.json';
import { site } from '@shared/data/site';
import { allResults, highlights, medalClass } from '@shared/lib/cycling';
import { ordinal } from '@shared/lib/format';

const { rider, source, generatedAt } = data;

// Scraped PCS results merged with the hand-written ones PCS doesn't carry.
const results = allResults();
const hasManual = results.some((r) => r.source === 'manual');

// Age from birthdate.
function ageFrom(iso: string | null): number | null {
  if (!iso) return null;
  const b = new Date(iso);
  const now = new Date();
  let age = now.getFullYear() - b.getFullYear();
  const m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return age;
}
const age = ageFrom(rider.birthdate);

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const palmares = highlights();
---

<BaseLayout
  title="Cycling"
  description="Race results and career highlights for Vedran Chichov, from ProCyclingStats."
>
  <section class="container cycling">
    <PageHeader title="Cycling">
      <Fragment slot="lede">
        I race on the road — a time-trial rider at heart. Here are my career highlights and results,
        mostly pulled from ProCyclingStats.
      </Fragment>
    </PageHeader>

    <WoodPanel class="profile">
      <dl class="profile-grid">
        <div><dt class="meta-label">Country</dt><dd>{rider.nationalityName ?? '—'}</dd></div>
        {
          age !== null && (
            <div>
              <>
                <dt class="meta-label">Age</dt>
                <dd>{age}</dd>
              </>
            </div>
          )
        }
        {
          rider.team?.name && (
            <div>
              <>
                <dt class="meta-label">Team</dt>
                <dd>
                  <a href={site.team.url} target="_blank" rel="noopener">
                    {rider.team.name}
                  </a>
                </dd>
              </>
            </div>
          )
        }
      </dl>
      <PixelButton href={source} variant="ghost">Full profile on PCS</PixelButton>
    </WoodPanel>

    {
      palmares.length > 0 && (
        <section class="block" aria-labelledby="palmares-h">
          <h2 id="palmares-h">Career highlights</h2>
          <ul class="palmares">
            {palmares.map((r) => (
              <li>
                <WoodPanel as="article" class="hl">
                  <span class:list={['medal', medalClass(r.rank)]} aria-hidden="true">
                    {r.rank}
                  </span>
                  <div class="hl-body">
                    <p class="hl-place meta-label">{ordinal(r.rank)} place</p>
                    <h3 class="hl-race">
                      {r.url ? (
                        <a href={r.url} target="_blank" rel="noopener">
                          {r.race}
                        </a>
                      ) : (
                        r.race
                      )}
                    </h3>
                    <p class="hl-meta">
                      {fmtDate(r.date)}
                      {r.raceClass && <span class="chip meta-label">{r.raceClass}</span>}
                      {r.source === 'manual' && (
                        <span class="chip off-pcs meta-label" title="Not listed on ProCyclingStats">
                          off-PCS
                        </span>
                      )}
                    </p>
                  </div>
                </WoodPanel>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="block" aria-labelledby="results-h">
      <h2 id="results-h">All results</h2>
      <WoodPanel class="table-wrap">
        <table class="results">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Race</th>
              <th scope="col">Class</th>
              <th scope="col" class="num">Result</th>
            </tr>
          </thead>
          <tbody>
            {
              results.map((r) => (
                <tr>
                  <td data-label="Date">{fmtDate(r.date)}</td>
                  <td data-label="Race">
                    {r.url ? (
                      <a href={r.url} target="_blank" rel="noopener">
                        {r.race}
                      </a>
                    ) : (
                      r.race
                    )}
                  </td>
                  <td data-label="Class">
                    {r.raceClass ?? '—'}
                    {r.source === 'manual' && (
                      <span class="mark" title="Not listed on ProCyclingStats">
                        *
                      </span>
                    )}
                  </td>
                  <td data-label="Result" class="num">
                    {r.rank != null ? ordinal(r.rank) : 'DNF'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </WoodPanel>
    </section>

    <p class="synced meta-label">
      Synced from ProCyclingStats · updated {fmtDate(generatedAt.slice(0, 10))}
      {hasManual && <span class="synced-note">* added by hand — not listed on PCS</span>}
    </p>
  </section>
</BaseLayout>

<style>
  .cycling {
    padding-block: var(--space-2xl);
  }

  .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .profile-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
  }
  .profile-grid dt {
    margin-bottom: 0.15rem;
  }
  .profile-grid dd {
    margin: 0;
    font-size: var(--text-lg);
  }

  .block {
    margin-top: var(--space-xl);
  }
  .block h2 {
    margin-bottom: var(--space-sm);
  }

  .palmares {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hl {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }
  .medal {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-family: var(--font-num);
    font-size: 1.7rem;
    color: var(--wood-dark);
    background: var(--surface-2);
    border: 3px solid var(--frame-dark);
    border-radius: 50%;
  }
  /* gold/silver/bronze are light discs, so they keep the dark numeral; the plain disc uses
     the surface colour and needs the theme's own text colour to stay readable in dark mode */
  .medal.plain {
    color: var(--text);
  }
  .medal.gold {
    background: #f2c94c;
  }
  .medal.silver {
    background: #d5d8dc;
  }
  .medal.bronze {
    background: #d79a63;
  }
  .hl-body {
    min-width: 0;
  }
  .hl-place {
    margin: 0 0 0.15rem;
    color: var(--accent-strong);
  }
  .hl-race {
    margin: 0 0 0.35rem;
    font-size: var(--text-lg);
  }
  .hl-race a {
    color: var(--text);
    text-decoration: none;
  }
  .hl-race a:hover {
    color: var(--link);
  }
  .hl-meta {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }
  .results {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .results th,
  .results td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--surface-2);
  }
  .results thead th {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--text-muted);
  }
  .results .num {
    text-align: right;
    font-family: var(--font-num);
    font-size: 1.15rem;
  }
  .results a {
    color: var(--text);
    text-decoration: none;
  }
  .results a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .off-pcs {
    border-style: dashed;
  }
  .mark {
    color: var(--text-muted);
  }

  .synced {
    margin-top: var(--space-lg);
  }
  .synced-note {
    display: block;
    margin-top: 0.25rem;
  }

  /* Stack the results table into cards on small screens. */
  @media (max-width: 560px) {
    .results thead {
      display: none;
    }
    .results,
    .results tbody,
    .results tr,
    .results td {
      display: block;
      width: 100%;
    }
    .results tr {
      margin-bottom: 0.75rem;
      border: 2px solid var(--surface-2);
      border-radius: var(--radius);
      padding: 0.25rem 0.5rem;
    }
    .results td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--surface-2);
    }
    .results td::before {
      content: attr(data-label);
      font-family: var(--font-body);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-meta);
      color: var(--text-muted);
    }
    .results .num {
      text-align: right;
    }
  }
</style>
