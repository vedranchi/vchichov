---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, slugifyTag } from '@shared/lib/format';
import '../styles/prose.css';

export const getStaticPaths = (async () => {
  // Drafts stay visible while writing but must not be built in production — without this
  // filter a draft still gets a page and is reachable by direct URL, unlike everywhere
  // else that lists posts.
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
  <article class="container post">
    <header class="post-header">
      <a href="/" class="back pixel-label">← All posts</a>
      <h1>{title}</h1>
      <p class="meta meta-label">
        {formatDate(pubDate)}
        {updatedDate && <span>· updated {formatDate(updatedDate)}</span>}
        {draft && <span class="draft">· draft</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="chip-row">
            {tags.map((tag) => (
              <li>
                <a class="chip meta-label" href={`/tags/${slugifyTag(tag)}`}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-block: var(--space-2xl);
  }
  .post-header {
    margin-bottom: var(--space-lg);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--accent-strong);
    text-decoration: none;
  }
  .back:hover {
    color: var(--link-hover);
  }
  .post-header h1 {
    margin: 0 0 0.5rem;
  }
  .meta {
    margin: 0 0 var(--space-xs);
  }
  .draft {
    color: var(--berry);
  }
</style>
