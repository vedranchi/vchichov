---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { slugifyTag } from '@shared/lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const tags = new Map<string, { label: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!tags.has(slug)) tags.set(slug, { label: tag, posts: [] });
      tags.get(slug)!.posts.push(post);
    }
  }
  return [...tags.entries()].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---

<BaseLayout title={`#${label}`} description={`Posts tagged ${label}.`}>
  <section class="container tag-page">
    <PageHeader title={`#${label}`} back={{ href: '/', label: '← All posts' }}>
      <Fragment slot="lede">
        {posts.length} post{posts.length === 1 ? '' : 's'} tagged “{label}”.
      </Fragment>
    </PageHeader>

    <ul class="grid">
      {
        posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .tag-page {
    padding-block: var(--space-2xl);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
