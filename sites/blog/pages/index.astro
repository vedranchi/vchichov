---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Farm from '../components/Farm.astro';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

{/* The root of blog.vchichov.com: a small farm where every crop is a post. */}
<BaseLayout>
  <section class="container farm-page">
    <PageHeader title="The farm">
      <Fragment slot="lede">
        Thoughts on code, riding, and whatever else I'm figuring out. Every crop in the field is a
        post.
      </Fragment>
    </PageHeader>
    <Farm posts={posts} />
  </section>
</BaseLayout>

<style>
  .farm-page {
    padding-block: var(--space-2xl);
  }
</style>
