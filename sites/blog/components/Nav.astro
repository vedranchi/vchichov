---
import { site } from '@shared/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <nav class="container nav" aria-label="Primary">
    <a href="/" class="brand">
      <span class="brand-name">{site.shortName}</span>
    </a>

    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="nav-links">
      <span class="pixel-label" data-label>Menu</span>
    </button>

    <div class="nav-end">
      <ul id="nav-links" class="nav-links">
        {
          site.nav.blog.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  { active: !item.external && isActive(item.href), outbound: item.external },
                ]}
                aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: var(--bg-alt);
    border-bottom: 3px solid var(--frame-dark);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    /* keeps the bar at ~66px: a nav eating more than 80px of the viewport is a tax on
       every page, and this one only holds four links */
    padding-block: var(--space-2xs);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: grid;
    place-items: center;
    min-height: 44px;
    font-family: var(--font-pixel);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    padding: 0.35rem 0.7rem;
    border: 3px solid transparent;
    border-radius: var(--radius);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
  }
  .nav-link.active {
    background: var(--accent-ui);
    color: var(--on-accent);
    border-color: var(--frame-dark);
  }
  /* The link back to the portfolio. Set apart so it reads as leaving the farm, and
     labelled with the destination host rather than an arrow. */
  .nav-link.outbound {
    margin-left: 0.5rem;
    color: var(--link);
    text-transform: none;
  }
  .nav-link.outbound:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .nav-toggle {
    display: none;
    min-height: 44px;
    margin-left: auto;
    background: var(--surface);
    color: var(--text);
    border: 3px solid var(--frame-ui);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: inline-block;
    }
    /* Unwrap nav-end so the theme toggle sits beside the Menu button, and the opened link
       list drops onto a row of its own below them. */
    .nav-end {
      display: contents;
    }
    .nav-links {
      display: none;
      order: 1;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .nav-links.open {
      display: flex;
      gap: var(--space-3xs);
      padding-block: var(--space-2xs) var(--space-3xs);
    }
    .nav-link {
      width: 100%;
    }
  }
</style>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const label = toggle.querySelector('[data-label]');
    if (label) label.textContent = open ? 'Close' : 'Menu';
  });
</script>
