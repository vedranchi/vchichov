---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type { Project } from '../components/ProjectCard.astro';
import { site } from '@shared/data/site';
import data from '@shared/data/projects.json';

// Newest first. projects.json is regenerated by `npm run sync:projects`.
const projects = (data.projects as Project[])
  .slice()
  .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt));
const githubUrl = site.socials.find((s) => s.label === 'GitHub')?.href ?? 'https://github.com';
---

<BaseLayout title="Work" description="Public repositories by Vedran Chichov, synced from GitHub.">
  <section class="container page">
    <header class="page-head">
      <h1 class="page-title">Work</h1>
      <p class="page-lede measure">
        Everything public, newest first. Pulled straight from GitHub, so this is whatever I'm
        actually working on.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="cards">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing public right now.</p>
      )
    }

    <p class="more">
      <a class="inline" href={githubUrl} rel="noopener"> All repositories on GitHub </a>
    </p>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 8vw, 4rem) 1rem;
  }
  .page-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .page-title {
    font-size: clamp(2.25rem, 6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .page-lede {
    margin-top: 1rem;
    color: var(--text-muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .empty {
    color: var(--text-muted);
  }
  .more {
    margin-top: 1.75rem;
  }
</style>
