---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type { Project } from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '@shared/data/site';
import { home } from '@shared/data/home';
import projectData from '@shared/data/projects.json';

const all = projectData.projects as Project[];
// Featured order comes from home.ts; anything missing is skipped rather than erroring.
const projects = home.featured
  .map((name) => all.find((p) => p.name === name))
  .filter((p): p is Project => Boolean(p));
const blogHost = site.urls.blog.replace(/^https:\/\//, '');
---

<BaseLayout>
  <section class="container hero">
    <h1 class="hero-name">{site.name}</h1>
    <p class="hero-role">Developer</p>

    <div class="hero-intro prose measure">
      <p>Hi, I'm Vedran, a first-year CS student in Skopje, Macedonia.</p>
      <p>
        I split my time between building software and racing bikes. My main project is{' '}
        <strong>Glucoread</strong>, a diabetes tracking app that's live and running. If you want to
        see what I'm thinking about, I write on my blog at{' '}
        <a class="inline" href={site.urls.blog} rel="noopener">{blogHost}</a>.
      </p>
    </div>

    <p class="hero-offer">
      Currently taking on website projects. <a class="inline" href="/work-with-me">Work with me</a>
    </p>

    <SocialLinks />
  </section>

  <section class="container work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-title">Projects</h2>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="more">
      <a class="inline" href="/projects">See everything I've built</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 8vw, 4.5rem) clamp(2rem, 6vw, 3.5rem);
  }
  .hero-name {
    font-size: clamp(2.5rem, 8vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .hero-role {
    margin-top: 0.4rem;
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    font-weight: 500;
    color: var(--text);
  }
  .hero-intro {
    margin-top: 2.25rem;
    display: grid;
    gap: 1.1rem;
  }
  .hero-intro strong {
    font-weight: 700;
  }
  .hero-offer {
    margin-top: 1.75rem;
    font-weight: 600;
  }
  /* The icon row sits well below the text, as in the reference. */
  :global(.hero .socials) {
    margin-top: 2.75rem;
  }

  .work {
    padding-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: 1.5rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .more {
    margin-top: 1.75rem;
  }
</style>
