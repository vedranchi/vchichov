---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '@shared/data/site';
import cycling from '@shared/data/cycling.json';

const born = new Date(cycling.rider.birthdate);
const now = new Date();
let age = now.getFullYear() - born.getFullYear();
const beforeBirthday =
  now.getMonth() < born.getMonth() ||
  (now.getMonth() === born.getMonth() && now.getDate() < born.getDate());
if (beforeBirthday) age -= 1;
---

{
  /*
   * Everything here comes from data already in the repo (cycling.json, palmares.ts,
   * projects.json), so it stays true as those update. The age is worked out from the
   * birthdate in cycling.json, so it never needs editing.
   */
}
<BaseLayout
  title="About"
  description="Vedran Chichov — a developer and bike racer from Skopje, Macedonia."
>
  <section class="container page">
    <h1 class="page-title">About</h1>

    <div class="prose measure">
      <p>
        I'm {age}, a first-year computer science student from Skopje. I spend most of my time
        building things and learning how computers and software work, and lately networking too. The
        rest goes into training and racing bikes.
      </p>

      <h2 class="section-title">Software</h2>
      <p>
        My biggest project yet is <strong>Glucoread</strong>, an app for tracking glucose, insulin
        and meals day to day. It's a personal project, not a medical tool. It's built with Django
        and PostgreSQL, and I host it myself on an Oracle Cloud VM: Docker, Caddy, backups, the lot.
      </p>
      <p>
        It's also where I've learned the most. Something that's actually deployed can't be left
        half-finished, so it taught me more than any tutorial.
      </p>

      <h2 class="section-title">Racing</h2>
      <p>
        I ride for {site.team.name}. In 2026 I won the Macedonian national road race title in the
        under-23 category, and took silver in the time trial the day before. I actively participate
        in races abroad too.
      </p>

      <p class="more">
        Race results live on <a class="inline" href={`${site.urls.blog}/cycling`} rel="noopener"
          >the blog</a
        >, along with anything I write down.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 8vw, 4rem) 1rem;
  }
  .page-title {
    font-size: clamp(2.25rem, 6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
  }
  .prose p + p {
    margin-top: 1.1rem;
  }
  .section-title {
    font-size: clamp(1.5rem, 3.5vw, 1.875rem);
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    /* A short orange rule instead of a filled block — the accent stays a ground, and this
       keeps the page from turning into a stack of orange bars. */
    border-bottom: 4px solid var(--accent);
    padding-bottom: 0.4rem;
    display: inline-block;
  }
  .prose strong {
    font-weight: 700;
  }
  .more {
    margin-top: 2.25rem;
    color: var(--text-muted);
  }
</style>
