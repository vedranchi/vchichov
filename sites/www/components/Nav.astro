---
import { site } from '@shared/data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
const internal = site.nav.www.filter((item) => !item.external);
const external = site.nav.www.filter((item) => item.external);
---

{/* A centred orange slab floating over the page, per the reference. */}
<header class="site-header">
  <nav class="nav box" aria-label="Primary">
    <ul class="nav-links">
      {
        internal.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    {/* The way off to the blog, kept apart from the pages of this site, plus the toggle. */}
    <div class="nav-end">
      {
        external.map((item) => (
          <a href={item.href} class="nav-link" rel="noopener">
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: center;
    padding: clamp(1rem, 3vw, 1.75rem) var(--gutter) 0;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    /* The one orange block on most pages. Always black-on-orange — see tokens.css. */
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.4rem 0.6rem;
  }
  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 2px solid transparent;
    border-radius: 6px;
    color: var(--on-accent);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
  }
  .nav-link:hover {
    border-color: var(--on-accent);
  }
  /* The current page is outlined rather than filled — there is already a fill here. */
  .nav-link.active {
    border-color: var(--on-accent);
    font-weight: 600;
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* A hairline between this site's pages and the link that leaves for the blog. */
  .nav-end::before {
    content: '';
    width: 2px;
    height: 1.1em;
    background: var(--on-accent);
    opacity: 0.35;
  }

  /* Too narrow for one row: this site's pages across the top, the blog link and the toggle
     below, with the hairline turned horizontal between them. */
  @media (max-width: 560px) {
    /* Capped so the spaced-out links stay close together on wider phones. */
    .nav {
      width: min(100%, 25rem);
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .nav-links {
      justify-content: space-between;
    }
    .nav-end {
      justify-content: space-between;
      padding-top: 0.25rem;
      border-top: 2px solid color-mix(in srgb, var(--on-accent) 35%, transparent);
    }
    .nav-end::before {
      content: none;
    }
    .nav-link {
      padding: 0.45rem 0.6rem;
      font-size: 1rem;
    }
  }
  /* Smallest phones: just enough tighter to keep the four pages on one row. */
  @media (max-width: 380px) {
    .nav-links {
      gap: 0;
    }
    .nav-link {
      padding-inline: 0.3rem;
      font-size: 0.9375rem;
    }
  }
</style>
