---
// The icon row from the reference. Inline SVG paths, no icon library and no CDN.
// Each link carries a visible-to-screen-readers label; the glyph itself is decorative.
import { site } from '@shared/data/site';

interface Props {
  /** Adds the boxed outline + press behaviour. Off by default for the quiet hero row. */
  boxed?: boolean;
}
const { boxed = false }: Props = Astro.props;

const links = [
  { key: 'email', label: 'Email', href: `mailto:${site.email}` },
  ...site.socials.filter((s) => s.me).map((s) => ({ key: s.label, label: s.label, href: s.href })),
];
---

<ul class="socials">
  {
    links.map((l) => (
      <li>
        <a
          class:list={['social', { box: boxed, 'box--press': boxed }]}
          href={l.href}
          rel={l.href.startsWith('mailto:') ? undefined : 'me noopener'}
        >
          <span class="sr-only">{l.label}</span>
          {l.key === 'email' && (
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 6.5h19v11h-19z" />
              <path d="M2.5 7l9.5 6.5L21.5 7" />
            </svg>
          )}
          {l.key === 'GitHub' && (
            <svg class="icon icon--fill" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8z" />
            </svg>
          )}
          {l.key === 'ProCyclingStats' && (
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5.5" cy="17" r="3.6" />
              <circle cx="18.5" cy="17" r="3.6" />
              <path
                d="M5.5 17l4-8h5l4 8M9.5 9h5.5M13 9l2.5 8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--text);
  }
  .social:hover {
    color: var(--accent);
  }
  .social.box:hover {
    /* On a boxed icon the orange belongs to the fill, not the glyph. */
    background: var(--accent);
    color: var(--on-accent);
  }
  .icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
  }
  .icon--fill {
    fill: currentColor;
    stroke: none;
  }
</style>
