---
import type { CollectionEntry } from 'astro:content';
import WoodPanel from './WoodPanel.astro';
import { formatDate, slugifyTag } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post }: Props = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<WoodPanel as="article" class="post-card">
  <p class="post-date meta-label">{formatDate(pubDate)}</p>
  <h2 class="post-title">
    <a href={`/blog/${post.id}`}>{title}</a>
  </h2>
  {description && <p class="post-desc body-text">{description}</p>}
  {
    tags.length > 0 && (
      <ul class="post-tags chip-row">
        {tags.map((tag) => (
          <li>
            <a class="chip meta-label" href={`/blog/tags/${slugifyTag(tag)}`}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</WoodPanel>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
  }
  .post-date {
    margin: 0;
  }
  .post-title {
    margin: 0;
    font-size: var(--text-xl);
  }
  .post-title a {
    color: var(--text);
    text-decoration: none;
  }
  .post-title a:hover {
    color: var(--link);
  }
  /* typography comes from .body-text; this only makes the card bottoms line up */
  .post-desc {
    flex: 1;
  }
  .post-tags {
    margin-top: var(--space-3xs);
  }
</style>
