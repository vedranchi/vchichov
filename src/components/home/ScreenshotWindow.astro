---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A screenshot framed as a chunky pixel browser window. The screenshots we use are clean
// viewport captures with no chrome of their own, so this doesn't double up.
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Shown in the fake address bar. */
  url: string;
  /** Aspect ratio of the visible window. Wider than the source crops the dead space off the
   *  bottom via object-position: top. */
  ratio?: string;
  class?: string;
}
const { src, alt, url, ratio = '1.9', class: className = '' } = Astro.props;
---

<figure class:list={['window', className]}>
  <div class="chrome">
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="url meta-label">{url}</span>
  </div>
  <div class="shot" style={`aspect-ratio:${ratio};`}>
    <Image src={src} alt={alt} widths={[640, 960, 1600]} loading="lazy" decoding="async" />
  </div>
</figure>

<style>
  .window {
    margin: 0;
    background: var(--surface);
    border: 3px solid var(--frame-dark);
    border-radius: var(--radius);
    box-shadow: var(--pixel) var(--pixel) 0 0 var(--frame-dark);
    overflow: hidden;
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.6rem;
    background: var(--surface-2);
    border-bottom: 3px solid var(--frame-dark);
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--frame);
    border: 2px solid var(--frame-dark);
    border-radius: 2px;
  }
  .url {
    margin-left: 0.4rem;
    text-transform: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .shot {
    width: 100%;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* crop from the bottom — the capture has a blank band down there */
    object-fit: cover;
    object-position: top;
  }
</style>
