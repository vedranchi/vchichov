---
import type { CollectionEntry } from 'astro:content';
import WoodPanel from '../WoodPanel.astro';
import PixelButton from '../PixelButton.astro';
import { formatDate, slugifyTag } from '../../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post }: Props = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<div class="spotlight">
  <!-- Pixel notebook, drawn rather than photographed: the blog has no picture of its own. -->
  <div class="motif" aria-hidden="true">
    <svg viewBox="0 0 60 60" role="presentation">
      <rect class="page" x="10" y="8" width="40" height="44"></rect>
      <rect class="spine" x="10" y="8" width="5" height="44"></rect>
      <g class="rings">
        <rect x="11" y="14" width="3" height="2"></rect>
        <rect x="11" y="22" width="3" height="2"></rect>
        <rect x="11" y="30" width="3" height="2"></rect>
        <rect x="11" y="38" width="3" height="2"></rect>
        <rect x="11" y="46" width="3" height="2"></rect>
      </g>
      <g class="lines">
        <rect x="19" y="16" width="26" height="2"></rect>
        <rect x="19" y="22" width="26" height="2"></rect>
        <rect x="19" y="28" width="18" height="2"></rect>
        <rect x="19" y="36" width="26" height="2"></rect>
        <rect x="19" y="42" width="22" height="2"></rect>
      </g>
      <g class="quill">
        <rect x="38" y="30" width="2" height="2"></rect>
        <rect x="40" y="28" width="2" height="2"></rect>
        <rect x="42" y="26" width="2" height="2"></rect>
        <rect x="44" y="24" width="2" height="2"></rect>
      </g>
    </svg>
  </div>

  <WoodPanel class="card">
    <p class="date pixel-label">{formatDate(pubDate)}</p>
    <h3 class="title"><a href={`/blog/${post.id}`}>{title}</a></h3>
    {description && <p class="desc">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <a class="tag pixel-label" href={`/blog/tags/${slugifyTag(tag)}`}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="actions">
      <PixelButton href={`/blog/${post.id}`}>Read it</PixelButton>
    </div>
  </WoodPanel>
</div>

<style>
  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
  }
  .motif svg {
    display: block;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
    height: auto;
    shape-rendering: crispEdges;
  }
  .page {
    fill: var(--surface);
    stroke: var(--frame-dark);
    stroke-width: 2;
  }
  .spine {
    fill: var(--frame);
  }
  .rings {
    fill: var(--frame-dark);
  }
  .lines {
    fill: var(--text-muted);
    opacity: 0.55;
  }
  .quill {
    fill: var(--accent-strong);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .date {
    margin: 0;
    color: var(--text-muted);
  }
  .title {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--link);
  }
  .desc {
    margin: 0;
    color: var(--text-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  .tag {
    display: inline-block;
    background: var(--surface-2);
    border: 2px solid var(--frame);
    border-radius: 2px;
    padding: 0.15rem 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .tag:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .actions {
    margin-top: 0.5rem;
  }

  @media (max-width: 780px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
    .motif svg {
      max-width: 10rem;
    }
  }
</style>
