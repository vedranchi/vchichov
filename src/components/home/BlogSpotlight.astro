---
import type { CollectionEntry } from 'astro:content';
import WoodPanel from '../WoodPanel.astro';
import PixelButton from '../PixelButton.astro';
import { formatDate, slugifyTag } from '../../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post }: Props = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<div class="spotlight">
  <!-- Pixel notebook, drawn rather than photographed: the blog has no picture of its own.
       It sits directly above the post it introduces, not beside it: the band already reads
       left-aligned, and a side column left the motif floating against nothing. -->
  <div class="motif" aria-hidden="true">
    <svg viewBox="0 0 60 60" role="presentation">
      <rect class="page" x="10" y="8" width="40" height="44"></rect>
      <rect class="spine" x="10" y="8" width="5" height="44"></rect>
      <g class="rings">
        <rect x="11" y="14" width="3" height="2"></rect>
        <rect x="11" y="22" width="3" height="2"></rect>
        <rect x="11" y="30" width="3" height="2"></rect>
        <rect x="11" y="38" width="3" height="2"></rect>
        <rect x="11" y="46" width="3" height="2"></rect>
      </g>
      <g class="lines">
        <rect x="19" y="16" width="26" height="2"></rect>
        <rect x="19" y="22" width="26" height="2"></rect>
        <rect x="19" y="28" width="18" height="2"></rect>
        <rect x="19" y="36" width="26" height="2"></rect>
        <rect x="19" y="42" width="22" height="2"></rect>
      </g>
      <g class="quill">
        <rect x="38" y="30" width="2" height="2"></rect>
        <rect x="40" y="28" width="2" height="2"></rect>
        <rect x="42" y="26" width="2" height="2"></rect>
        <rect x="44" y="24" width="2" height="2"></rect>
      </g>
    </svg>
  </div>

  <WoodPanel class="card">
    <p class="date meta-label">{formatDate(pubDate)}</p>
    <h3 class="title"><a href={`/blog/${post.id}`}>{title}</a></h3>
    {description && <p class="desc body-text">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="tags chip-row">
          {tags.map((tag) => (
            <li>
              <a class="chip meta-label" href={`/blog/tags/${slugifyTag(tag)}`}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="actions">
      <PixelButton href={`/blog/${post.id}`}>Read it</PixelButton>
    </div>
  </WoodPanel>
</div>

<style>
  .spotlight {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .motif svg {
    display: block;
    width: 6.5rem;
    height: auto;
    shape-rendering: crispEdges;
  }
  .page {
    fill: var(--surface);
    stroke: var(--frame-dark);
    stroke-width: 2;
  }
  .spine {
    fill: var(--frame);
  }
  .rings {
    fill: var(--frame-dark);
  }
  .lines {
    fill: var(--text-muted);
    opacity: 0.55;
  }
  .quill {
    fill: var(--accent-strong);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    /* the band is 1040px wide; an unconstrained card turns the summary into a 100ch line */
    max-width: 62ch;
    width: 100%;
  }
  .date {
    margin: 0;
  }
  .title {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--link);
  }
  .desc {
    margin: 0;
  }
  .tags {
    margin-top: var(--space-3xs);
  }
  .actions {
    margin-top: var(--space-2xs);
  }
</style>
