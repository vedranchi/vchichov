---
import PixelButton from '../PixelButton.astro';
import ScreenshotWindow from './ScreenshotWindow.astro';
import shot from '../../assets/glucoread.png';
import { home } from '../../data/home';
import type { Project } from '../ProjectCard.astro';

interface Props {
  project: Project;
}
const { project }: Props = Astro.props;

// Strip the trailing stack sentence — the homepage shows languages as chips already.
const blurb = project.description?.split('. ')[0].replace(/\.$/, '') ?? '';
const displayUrl = project.homepage?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? '';
---

<div class="spotlight">
  <ScreenshotWindow
    src={shot}
    alt={home.alt.project}
    url={displayUrl}
    ratio="2.4"
    class="shot-col"
  />

  <div class="detail">
    <h3 class="name">{project.name}</h3>
    {blurb && <p class="blurb body-text">{blurb}.</p>}

    {
      project.languages.length > 0 && (
        <ul class="chips chip-row">
          {project.languages.slice(0, 5).map((l) => (
            <li class="chip meta-label">{l}</li>
          ))}
        </ul>
      )
    }

    <div class="actions">
      {project.homepage && <PixelButton href={project.homepage}>Visit {project.name}</PixelButton>}
      <PixelButton href={project.url} variant="ghost">Code</PixelButton>
    </div>
  </div>
</div>

<style>
  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
  }
  .detail {
    min-width: 0;
  }
  .name {
    margin: 0 0 var(--space-3xs);
    font-size: var(--text-2xl);
  }
  .blurb {
    margin: 0 0 var(--space-xs);
  }
  .chips {
    margin-bottom: var(--space-sm);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  @media (max-width: 780px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
    /* picture first on mobile — it's the hook */
    .shot-col {
      order: -1;
    }
  }
</style>
