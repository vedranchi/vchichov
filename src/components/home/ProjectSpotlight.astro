---
import PixelButton from '../PixelButton.astro';
import ScreenshotWindow from './ScreenshotWindow.astro';
import shot from '../../assets/glucoread.png';
import { home } from '../../data/home';
import type { Project } from '../ProjectCard.astro';

interface Props {
  project: Project;
}
const { project }: Props = Astro.props;

// Strip the trailing stack sentence — the homepage shows languages as chips already.
const blurb = project.description?.split('. ')[0].replace(/\.$/, '') ?? '';
const displayUrl = project.homepage?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? '';
---

<div class="spotlight">
  <ScreenshotWindow src={shot} alt={home.alt.project} url={displayUrl} class="shot-col" />

  <div class="detail">
    <h3 class="name">{project.name}</h3>
    {blurb && <p class="blurb">{blurb}.</p>}

    {
      project.languages.length > 0 && (
        <ul class="chips">
          {project.languages.slice(0, 5).map((l) => (
            <li class="chip pixel-label">{l}</li>
          ))}
        </ul>
      )
    }

    <div class="actions">
      {project.homepage && <PixelButton href={project.homepage}>Visit {project.name}</PixelButton>}
      <PixelButton href={project.url} variant="ghost">Code</PixelButton>
    </div>
  </div>
</div>

<style>
  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
  }
  .detail {
    min-width: 0;
  }
  .name {
    margin: 0 0 0.4rem;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }
  .blurb {
    margin: 0 0 0.9rem;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
  }
  .chip {
    background: var(--surface-2);
    border: 2px solid var(--frame);
    border-radius: 2px;
    padding: 0.15rem 0.4rem;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 780px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
    /* picture first on mobile — it's the hook */
    .shot-col {
      order: -1;
    }
  }
</style>
