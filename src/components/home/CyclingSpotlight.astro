---
import { Image } from 'astro:assets';
import WoodPanel from '../WoodPanel.astro';
import photo from '../../assets/nc2026.jpg';
import { home } from '../../data/home';
import { site } from '../../data/site';
import { featuredResult, medalClass, nationalTitles, seasonsRaced } from '../../lib/cycling';
import { formatDate, ordinal } from '../../lib/format';
import cyclingData from '../../data/cycling.json';

const result = featuredResult();
const teamName = cyclingData.rider.team?.name ?? site.team.name;

// "National Championships North Macedonia MU - Road Race" -> "Road Race"
const discipline = result?.race.split(' - ').at(-1) ?? '';
const isNationalTitle = result?.rank === 1 && result?.raceClass === 'NC';

const stats = [
  { label: 'National titles', value: String(nationalTitles()) },
  { label: 'Seasons raced', value: String(seasonsRaced()) },
];
---

<div class="spotlight">
  <div class="detail">
    {
      result && (
        <WoodPanel class="result">
          <span class:list={['medal', medalClass(result.rank)]} aria-hidden="true">
            {result.rank}
          </span>
          <div class="result-body">
            <p class="crown meta-label">
              {isNationalTitle ? 'National champion' : `${ordinal(result.rank)} place`}
            </p>
            <h3 class="race">{discipline}</h3>
            <p class="meta">
              {[result.location, formatDate(result.date)].filter(Boolean).join(' · ')}
            </p>
          </div>
        </WoodPanel>
      )
    }
  </div>

  <figure class="photo">
    <Image
      src={photo}
      alt={home.alt.cycling}
      widths={[400, 578]}
      sizes="(max-width: 780px) 100vw, 40vw"
      loading="lazy"
      decoding="async"
    />
  </figure>
</div>

<dl class="stats">
  {
    stats.map((s) => (
      <div class="stat">
        <dt class="meta-label">{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))
  }
  <div class="stat">
    <dt class="meta-label">Team</dt>
    <dd class="stat-team">
      <a href={site.team.url} target="_blank" rel="noopener">{teamName}</a>
    </dd>
  </div>
</dl>

<style>
  /* Projects above this runs image-left / text-right. This band mirrors it and then breaks
     the grid entirely for the numbers, so the two do not read as the same template twice. */
  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
  }
  .detail {
    min-width: 0;
  }
  .photo {
    margin: 0;
    border: 3px solid var(--frame-dark);
    border-radius: var(--radius);
    box-shadow: var(--pixel) var(--pixel) 0 0 var(--frame-dark);
    overflow: hidden;
    line-height: 0;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .result {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .medal {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    font-family: var(--font-num);
    font-size: 1.9rem;
    color: var(--wood-dark);
    background: var(--surface-2);
    border: 3px solid var(--frame-dark);
    border-radius: 50%;
  }
  .medal.gold {
    background: #f2c94c;
  }
  .medal.silver {
    background: #d5d8dc;
  }
  .medal.bronze {
    background: #d79a63;
  }
  .result-body {
    min-width: 0;
  }
  .crown {
    margin: 0 0 0.15rem;
    color: var(--accent-strong);
  }
  .race {
    margin: 0 0 0.3rem;
    font-size: var(--text-lg);
  }
  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* The numbers get their own full-width row rather than being tucked beside the photo.
     VT323 earns its place here: it is a numeral face and these are the numerals. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-md);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 3px solid var(--frame);
  }
  .stat {
    min-width: 0;
  }
  .stat dt {
    margin-bottom: 0.15rem;
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-num);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    color: var(--text);
  }
  /* the team is a name, not a numeral, so it opts out of the VT323 treatment */
  .stat dd.stat-team {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-snug);
  }

  @media (max-width: 780px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
    /* picture first on mobile: it is the hook */
    .photo {
      order: -1;
      max-width: 24rem;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat-team {
      grid-column: 1 / -1;
    }
  }
</style>
