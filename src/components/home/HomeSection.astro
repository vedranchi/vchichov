---
// One band of the homepage: full-bleed background, fence-line top border, contained content.
// Bands alternate tone so the page reads as distinct plots of land as you scroll.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  tone?: 'default' | 'alt';
  class?: string;
}
const { id, eyebrow, title, lede, tone = 'default', class: className = '' } = Astro.props;
---

<section id={id} class:list={['band', `tone-${tone}`, className]} aria-labelledby={`${id}-h`}>
  <div class="container band-inner">
    <header class="band-head">
      <p class="eyebrow pixel-label">{eyebrow}</p>
      <h2 id={`${id}-h`}>{title}</h2>
      {lede && <p class="lede">{lede}</p>}
    </header>

    <slot />

    <footer class="band-foot">
      <slot name="cta" />
    </footer>
  </div>
</section>

<style>
  .band {
    border-top: 3px solid var(--frame-dark);
    /* scroll-margin so the sticky nav doesn't cover the heading on anchor jumps */
    scroll-margin-top: 4rem;
  }
  .tone-default {
    background: var(--bg);
  }
  .tone-alt {
    background: var(--bg-alt);
  }
  .band-inner {
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }
  .band-head {
    max-width: 60ch;
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }
  .eyebrow {
    color: var(--accent-strong);
    margin: 0 0 0.5rem;
  }
  .band-head h2 {
    margin: 0 0 0.5rem;
  }
  .lede {
    margin: 0;
    color: var(--text-muted);
  }
  .band-foot:not(:empty) {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
