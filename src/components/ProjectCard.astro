---
import WoodPanel from './WoodPanel.astro';
import PixelButton from './PixelButton.astro';

export interface Project {
  name: string;
  description: string;
  url: string;
  homepage: string | null;
  languages: string[];
  topics: string[];
  stars: number;
  updatedAt: string;
}
interface Props {
  project: Project;
}
const { project }: Props = Astro.props;

// A few GitHub-ish language colors; unknown languages fall back to a neutral tone.
const LANG_COLORS: Record<string, string> = {
  Python: '#3572a5',
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  Astro: '#ff5a03',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  SQL: '#e38c00',
  Dockerfile: '#384d54',
  'C++': '#f34b7d',
  C: '#555555',
  Java: '#b07219',
  Go: '#00add8',
  Rust: '#dea584',
  Vue: '#41b883',
  Svelte: '#ff3e00',
};
const langColor = (lang: string) => LANG_COLORS[lang] ?? '#9c8a6b';

const updated = new Date(project.updatedAt).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<WoodPanel as="article" class="project">
  <h3 class="project-name">
    <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
  </h3>

  {project.description && <p class="project-desc body-text">{project.description}</p>}

  {
    project.topics.length > 0 && (
      <ul class="chip-row">
        {project.topics.slice(0, 6).map((t) => (
          <li class="chip meta-label">{t}</li>
        ))}
      </ul>
    )
  }

  <div class="project-meta meta-label">
    {
      project.languages.map((lang) => (
        <span class="lang">
          <span class="lang-dot" style={`background:${langColor(lang)}`} aria-hidden="true" />
          {lang}
        </span>
      ))
    }
    {project.stars > 0 && <span class="stars">★ {project.stars}</span>}
    <span>Updated {updated}</span>
  </div>

  <div class="project-actions">
    <PixelButton href={project.url}>Code</PixelButton>
    {
      project.homepage && (
        <PixelButton href={project.homepage} variant="ghost">
          Live
        </PixelButton>
      )
    }
  </div>
</WoodPanel>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
  }
  .project-name {
    margin: 0;
    font-size: var(--text-xl);
    word-break: break-word;
  }
  .project-name a {
    text-decoration: none;
    color: var(--text);
  }
  .project-name a:hover {
    color: var(--link);
  }
  /* typography comes from .body-text; this only makes the card bottoms line up */
  .project-desc {
    flex: 1;
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-xs);
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }
  .lang-dot {
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--frame-dark);
    border-radius: 50%;
  }
  .stars {
    color: var(--highlight);
  }
  .project-actions {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-3xs);
  }
</style>
