---
// The newest post, as the home page's one big orange shape. The whole tile is the link.
// Ink on orange throughout (--on-accent), in both themes — see tokens.css.
import ArrowRight from '@phosphor-icons/core/assets/bold/arrow-right-bold.svg';
import { formatShortDate } from '../lib/format';
import { postHref, transitionName, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post }: Props = Astro.props;
const { title, description, pubDate } = post.data;
---

<a class="tile" href={postHref(post)}>
  <span class="tile-head mono">
    <span>Latest post</span>
    <time datetime={pubDate.toISOString()}>{formatShortDate(pubDate)}</time>
  </span>
  <span class="tile-title" style={`view-transition-name: ${transitionName(post.id)}`}>
    {title}
  </span>
  {description && <span class="tile-desc">{description}</span>}
  <span class="tile-go">
    Read it
    <ArrowRight aria-hidden="true" />
  </span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    transition:
      background-color 200ms ease,
      transform 300ms var(--ease-out);
  }
  .tile:hover {
    background: var(--accent-hover);
    transform: translateY(-3px);
  }
  .tile-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    text-transform: uppercase;
  }
  .tile-title {
    margin-top: auto;
    font-size: var(--step-2);
    font-stretch: var(--wide);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .tile-desc {
    max-width: 40ch;
    line-height: 1.5;
  }
  .tile-go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
  }
  .tile-go svg {
    width: 1.05em;
    height: 1.05em;
    transition: transform 200ms var(--ease-out);
  }
  .tile:hover .tile-go svg {
    transform: translateX(4px);
  }
</style>
