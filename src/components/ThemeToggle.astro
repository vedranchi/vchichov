---
// Light/dark switch. Icons are Phosphor (bold), inlined at build time — no CDN.
import Sun from '@phosphor-icons/core/assets/bold/sun-bold.svg';
import Moon from '@phosphor-icons/core/assets/bold/moon-bold.svg';
---

<button id="theme-toggle" type="button" class="theme-toggle" aria-label="Switch colour theme">
  <Sun class="icon icon-sun" aria-hidden="true" />
  <Moon class="icon icon-moon" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44x44 minimum touch target */
    width: 44px;
    height: 44px;
    margin-right: -0.6rem;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--text);
    transition: transform 300ms var(--ease-out);
  }
  .theme-toggle:hover {
    transform: rotate(-20deg);
  }
  .icon {
    width: 20px;
    height: 20px;
  }
  /* Show the mode you would switch TO, which is the convention people expect. */
  :root[data-theme='dark'] .icon-moon,
  :root[data-theme='light'] .icon-sun {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', function () {
      var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
    });
  })();
</script>
