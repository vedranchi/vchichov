---
// Mona Sans with both of its axes (weight 200–900, width 75–125%), and Geist Mono for the
// numbers. Self-hosted via @fontsource — no CDN, per the repo rules.
import '@fontsource-variable/mona-sans/standard.css';
import '@fontsource-variable/geist-mono';
// Preloaded so the display type doesn't arrive late and reflow the hero.
import monaLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-standard-normal.woff2?url';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
// The link-preview image. Regenerate with `npm run og` after changing the name or the look.
import ogImage from '../assets/og.png';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for blog posts, so link previews know what they're showing. */
  type?: 'website' | 'article';
}
const { title, description = site.description, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
// Astro.site comes from the build's config, so no page ever hard-codes the domain.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const feedUrl = new URL('rss.xml', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={feedUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Set the theme before paint to avoid a flash of the wrong palette. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
