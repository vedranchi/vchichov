---
import ArrowUpRight from '@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import type { Project } from '../components/ProjectTile.astro';
import { site } from '../data/site';
import data from '../data/projects.json';

// Newest first. projects.json is regenerated by `npm run sync:projects`.
const projects = (data.projects as Project[])
  .slice()
  .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt));
const githubUrl = site.socials.find((s) => s.label === 'GitHub')?.href ?? 'https://github.com';
---

<BaseLayout title="Projects" description="Public projects by Vedran Chichov, synced from GitHub.">
  <section class="container page">
    <header class="head">
      <h1 class="page-title display rise">Projects</h1>
      <p class="lede rise" style="--i: 1">
        Everything public, newest first. Pulled straight from GitHub, so this is whatever I'm
        actually working on.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="rows">
          {projects.map((project) => (
            <ProjectTile project={project} layout="row" />
          ))}
        </div>
      ) : (
        <p class="muted">Nothing public right now.</p>
      )
    }

    <p class="more">
      <a class="arrow-link" href={githubUrl} rel="me noopener"
        >All repositories on GitHub <ArrowUpRight aria-hidden="true" /></a
      >
    </p>
  </section>
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .rows {
    border-bottom: 1px solid var(--line);
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
