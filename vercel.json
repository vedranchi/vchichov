{
  "redirects": [
    {
      "source": "/contact",
      "destination": "/work-with-me",
      "permanent": true,
      "has": [{ "type": "host", "value": "vchichov.com" }]
    },
    {
      "source": "/",
      "destination": "https://vchichov.com/blog",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    },
    {
      "source": "/archive",
      "destination": "https://vchichov.com/blog",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    },
    {
      "source": "/tags/:tag*",
      "destination": "https://vchichov.com/blog/tags/:tag*",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    },
    {
      "source": "/:file(cycling|rss\\.xml|robots\\.txt|sitemap-index\\.xml|sitemap-0\\.xml)",
      "destination": "https://vchichov.com/:file",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    },
    {
      "source": "/:slug",
      "destination": "https://vchichov.com/blog/:slug",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    },
    {
      "source": "/:path*",
      "destination": "https://vchichov.com/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "blog.vchichov.com" }]
    }
  ]
}
