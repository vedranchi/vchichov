{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:blog": "astro dev --config astro.config.blog.mjs --port 4322",
    "build": "astro build",
    "build:blog": "astro build --config astro.config.blog.mjs",
    "build:all": "npm run build && npm run build:blog",
    "preview": "astro preview",
    "preview:blog": "astro preview --config astro.config.blog.mjs",
    "astro": "astro",
    "check": "astro check",
    "check:blog": "astro check --config astro.config.blog.mjs",
    "check:all": "npm run check && npm run check:blog",
    "format": "prettier --write .",
    "sync:projects": "node scripts/fetch_github.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.2.7",
    "@fontsource/silkscreen": "^5.2.8",
    "@fontsource/vt323": "^5.2.7",
    "astro": "^7.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
